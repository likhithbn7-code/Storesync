# ==============================================================================
# StoreSync Cloud Backend Environment Configuration (Render / Railway)
# ==============================================================================

# Aiven PostgreSQL Connection URI (SSL mode required)
POSTGRES_URI=postgres://avnadmin:<PG_PASSWORD>@<PG_HOST>:<PORT>/defaultdb?sslmode=require

# Aiven OpenSearch HTTPS URI
OPENSEARCH_URI=https://avnadmin:<OS_PASSWORD>@<OS_HOST>:<PORT>

# Aiven Apache Kafka Bootstrap Servers (Host:Port)
KAFKA_BOOTSTRAP_SERVERS=<KAFKA_HOST>:<PORT>
KAFKA_TOPIC=order-events
KAFKA_GROUP_ID=storesync-cloud-web-group

# Cloud Deployment: Kafka SSL Certs as Environment Variables (Render / Railway)
# Paste the raw contents or single-line escaped string (\n).
# app.py automatically recreates certs/ca.pem, certs/service.cert, and certs/service.key on startup.
KAFKA_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
KAFKA_SERVICE_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
KAFKA_SERVICE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Flask Server Port & Session Secret
PORT=5000
SECRET_KEY=storesync-production-secret-key-change-me

# Groq AI Concierge
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Gmail SMTP 6-Digit OTP Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password

# Razorpay Test / Production Keys
RAZORPAY_KEY_ID=rzp_test_storesync2026
RAZORPAY_KEY_SECRET=storesync_secret_key_2026
