# Aiven PostgreSQL Connection URI (SSL mode required)
POSTGRES_URI=postgres://avnadmin:<PG_PASSWORD>@<PG_HOST>:<PORT>/defaultdb?sslmode=require

# Aiven OpenSearch HTTPS URI
OPENSEARCH_URI=https://avnadmin:<OS_PASSWORD>@<OS_HOST>:<PORT>

# Aiven Apache Kafka Bootstrap Servers (Host:Port)
KAFKA_BOOTSTRAP_SERVERS=<KAFKA_HOST>:<PORT>
KAFKA_TOPIC=order-events

# Flask Server Port
PORT=5000
SECRET_KEY=storesync-production-secret-key-change-me

# Optional: SMTP for live OTP email delivery (if omitted, dev_otp is returned in API responses)
# SMTP_EMAIL=your-store@gmail.com
# SMTP_APP_PASSWORD=your-google-app-password
