# ==============================================================================
# StoreSync Frontend Environment Configuration (Vercel / Local)
# ==============================================================================

# In production (e.g. deployed on Vercel), set VITE_API_URL to your Render / Railway backend:
# VITE_API_URL=https://storesync-backend.onrender.com
#
# In local development, leave this empty to use Vite's built-in dev proxy to localhost:5000:
VITE_API_URL=
