# Copy this file to .env.local and fill values from Aiven's service connection details.
# Set AIVEN_CA_CERT_PATH to the downloaded Aiven CA PEM file to keep TLS certificate checks enabled.
API_PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DEFAULTDB
AIVEN_CA_CERT_PATH=./certs/ca.pem

OPENSEARCH_URL=https://HOST:PORT
OPENSEARCH_USERNAME=avnadmin
OPENSEARCH_PASSWORD=REPLACE_ME
OPENSEARCH_INDEX=storesync-products

KAFKA_BROKERS=HOST:PORT
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=REPLACE_ME
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_TOPIC=storesync.orders
